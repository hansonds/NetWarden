<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <Optimize>true</Optimize>
    <Deterministic>true</Deterministic>
    <!-- Version info lives in Program.cs -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <RootNamespace>NetWarden</RootNamespace>
    <AssemblyName>NetWarden</AssemblyName>
    <NoWarn>$(NoWarn);1701;1702</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Runtime.Serialization" />
    <EmbeddedResource Include="WinDivert.dll" LogicalName="NetWarden.WinDivert.dll" />
    <EmbeddedResource Include="WinDivert64.sys" LogicalName="NetWarden.WinDivert64.sys" />
    <None Remove="WinDivert-LICENSE.txt" />
  </ItemGroup>
  <!-- Lets any machine (including GitHub's) build for .NET Framework 4.8 without Visual Studio -->
  <ItemGroup Condition="'$(NoRefPack)' != 'true'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
